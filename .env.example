# Supabase (Postgres) — copy to .env and fill in
# Collect values with: bash .scratch/eventstreams-pivot/provision-supabase.sh

# Public dashboard values (safe to expose; RLS gates reads)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Session-pooler URI used by the Rust ingester — SECRET, never commit
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Reference values (not secrets)
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_REGION=eu-west-3
